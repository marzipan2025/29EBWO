<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <com.artbrain.ebwo.ui.PageView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 절반을 누르면 이 판이 나타나고 사라진다. 5초 동안 아무 조작이
         없으면 스스로 숨는다. -->
    <LinearLayout
        android:id="@+id/ui"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:textColor="@android:color/black"
            android:textSize="13sp"
            />

        <com.artbrain.ebwo.ui.TimelineView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/gap"
            android:layout_marginEnd="@dimen/gap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/gap">

            <Button
                android:id="@+id/toList"
                style="@style/InkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="목록" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/prev"
                style="@style/InkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="◀ 이전" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/refresh"
                style="@style/InkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="새로고침" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@drawable/hairline" />
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:gravity="center"
        android:padding="@dimen/gap"
        android:textColor="@android:color/black"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
